---
import * as NodeFS from "node:fs";
import * as NodePath from "node:path";

import DownloadButton from "../components/DownloadButton.astro";
import GithubGlyph from "../components/GithubGlyph.astro";
import PlatformGlyph from "../components/PlatformGlyph.astro";
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import { GITHUB_FORK_URL, GITHUB_REPOSITORY_URL, UPSTREAM_NAME } from "../lib/site";

const HARNESSES = [
  { name: "Claude", product: "Claude Code", mark: "/harnesses/claude-ai-icon.svg" },
  { name: "Codex", product: "Codex CLI", mark: "/harnesses/openai_dark.svg" },
  { name: "Grok", product: "Grok CLI", mark: "/harnesses/grok-dark.svg" },
  { name: "opencode", product: "OpenCode", mark: "/harnesses/opencode-dark.svg" },
  { name: "Cursor", product: "Cursor", mark: "/harnesses/cursor_light.svg" },
] as const;

const BUILDS = [
  { os: "mac", name: "macOS", arch: "Apple Silicon", format: "dmg", asset: "arm64.dmg", detect: true },
  { os: "mac", name: "macOS", arch: "Intel", format: "dmg", asset: "x64.dmg", detect: false },
  { os: "win", name: "Windows", arch: "10 and 11, x64", format: "exe", asset: "x64.exe", detect: true },
  { os: "linux", name: "Linux", arch: "x86_64", format: "AppImage", asset: "x86_64.AppImage", detect: true },
] as const;

const PRODUCT_SHOT = "/product/flows-v2.webp";
const PRODUCT_SHOT_WIDTH = 3120;
const PRODUCT_SHOT_HEIGHT = 1880;

const publicFile = (path: string) =>
  NodeFS.existsSync(NodePath.join(process.cwd(), "public", path)) ? `/${path}` : null;

const productShot = publicFile(PRODUCT_SHOT.slice(1));

const heroFile = (name: string) => publicFile(`hero/${name}`);

const HERO_WIDTHS = [1680, 2200, 2880, 3840, 5250];
const HERO_PORTRAIT_WIDTHS = [1200, 1920];

const HERO_SIZES = "max(100vw, min(240vh, 2625px))";

const HERO_PORTRAIT_SIZES = "max(100vw, 75vh)";

const srcset = (prefix: string, widths: number[], ext: string) =>
  widths
    .map((w) => [heroFile(`${prefix}-${w}.${ext}`), w] as const)
    .filter(([src]) => src !== null)
    .map(([src, w]) => `${src} ${w}w`)
    .join(", ");

const heroWideJpeg = srcset("hero", HERO_WIDTHS, "jpg");
const heroWideWebp = srcset("hero", HERO_WIDTHS, "webp");
const heroPortraitJpeg = srcset("hero-mobile", HERO_PORTRAIT_WIDTHS, "jpg");
const heroPortraitWebp = srcset("hero-mobile", HERO_PORTRAIT_WIDTHS, "webp");

const heroWide = HERO_WIDTHS.map((w) => heroFile(`hero-${w}.jpg`))
  .filter((src) => src !== null)
  .at(-1);
---

<Layout navOverlay>
  <section class="hero" id="top">
    {
      heroWide && (
        <picture class="hero-media">
          {heroPortraitWebp && (
            <source
              media="(max-aspect-ratio: 3/4)"
              type="image/webp"
              srcset={heroPortraitWebp}
              sizes={HERO_PORTRAIT_SIZES}
              width="1200"
              height="1600"
            />
          )}
          {heroPortraitJpeg && (
            <source
              media="(max-aspect-ratio: 3/4)"
              srcset={heroPortraitJpeg}
              sizes={HERO_PORTRAIT_SIZES}
              width="1200"
              height="1600"
            />
          )}
          {heroWideWebp && (
            <source type="image/webp" srcset={heroWideWebp} sizes={HERO_SIZES} width="2880" height="1207" />
          )}
          <source srcset={heroWideJpeg} sizes={HERO_SIZES} width="2880" height="1207" />
          <img
            src={heroWide}
            alt="A surfer with a laptop riding the shoulder of a long wave at dusk"
            width="2880"
            height="1207"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      )
    }
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-scrim-edge" aria-hidden="true"></div>

    <div class="hero-content">
      <div class="hero-block">
        <span class="hero-eyebrow">Not just another agentic development environment</span>

        <h1 class="hero-title display">
          Surf your backlog<br />with Aqqua ADE
        </h1>

        <div class="hero-meta">
          <div class="hero-meta-copy">
            <p class="hero-oss">
              <span>100% free and open source</span>
              <GithubGlyph />
            </p>
            <p class="hero-fork">
              A community fork of <a href="https://t3.codes" target="_blank" rel="noreferrer">t3.codes</a>
            </p>
          </div>

          <a class="hero-cta" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
            Try it now!
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="providers" class="sec-providers">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow eyebrow--dim">No API keys</span>
        <h2>Bring the subscription you already pay for.</h2>
        <p>
          aqqua drives every provider and harness through the plan you already
          have. Nothing is metered, resold, or routed through us — no token
          resale, no data collection, everything on your own machine.
        </p>
      </div>

      <div class="provider-row reveal">
        <span class="provider-label">Works with</span>
        {
          HARNESSES.map((harness) => (
            <span class="provider">
              <img src={harness.mark} alt={harness.product} width="20" height="20" loading="lazy" />
              {harness.name}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <section id="product" class="sec-product">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow eyebrow--dim">A card, mid-flight</span>
        <h2>Drop a card in. Walk away.</h2>
        <p>
          A card carries its own branch and worktree, and every step opens a
          fresh thread on the agent profile you assigned it. Steps hand
          artifacts forward, pause where you asked them to, and keep going while
          you read something else.
        </p>
      </div>

      <div class="product-actions reveal">
        <DownloadButton id="download-btn" labelId="download-label" href={RELEASES_URL} />
        <a class="btn btn-outline btn-lg" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
          <GithubGlyph size={16} />
          Read the source
        </a>
      </div>

      {
        productShot && (
          <figure class="product-shot reveal">
            <img
              src={productShot}
              alt="aqqua's Flows screen: a card on its own worktree has finished step two of three — analysis and design artifacts written, sub-agent tool calls listed beside the pipeline — and paused for review while four more cards wait in the backlog"
              width={PRODUCT_SHOT_WIDTH}
              height={PRODUCT_SHOT_HEIGHT}
              loading="lazy"
              decoding="async"
            />
          </figure>
        )
      }
    </div>
  </section>

  <section id="features" class="sec-features">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Core features</span>
        <h2>Define the agent. Run the swarm. Repeat the pipeline.</h2>
        <p>
          aqqua speaks ACP, so every provider lands in one interface. Name the
          agents you trust, run them in parallel, and pin the work you repeat to
          a flow.
        </p>
      </div>

      <div class="feature-row reveal">
        <div class="feature-copy">
          <h3>Name a model once, use it everywhere</h3>
          <p>
            A profile pins the provider, model and runtime a main agent runs
            under, saved under a name you choose. Cheap model for triage, deep
            reasoning for design.
          </p>
          <ul class="dashlist">
            <li><span aria-hidden="true">—</span><span>Provider, model, service tier and reasoning in one profile</span></li>
            <li><span aria-hidden="true">—</span><span>Assigned to the main agent on a thread or a flow step</span></li>
            <li><span aria-hidden="true">—</span><span>Assign per step in a flow, or per swarm</span></li>
          </ul>
        </div>

        <div class="panel">
          <div class="panel-head">
            <span class="panel-title">Agent Profiles</span>
            <span class="pill">+ Add profile</span>
          </div>
          <p class="panel-note">
            Machine-local roles for your main agents. Each profile pins the
            provider, model, and runtime the agent runs under, and can be
            assigned per thread or per flow step.
          </p>
          <div class="profiles">
            <div class="profile">
              <div class="profile-meta">
                <div class="profile-name">
                  <span>implementer</span>
                  <span class="tag">Built-in</span>
                </div>
                <span class="profile-spec">First enabled Codex · Inherits project default</span>
              </div>
              <span class="pill">Customize</span>
            </div>

            <div class="profile">
              <div class="profile-meta">
                <div class="profile-name"><span>coding</span></div>
                <span class="profile-spec">Claude · claude-fable-5 · Reasoning: High</span>
              </div>
              <div class="profile-actions" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/></svg>
              </div>
            </div>

            <div class="profile">
              <div class="profile-meta">
                <div class="profile-name"><span>Planning</span></div>
                <span class="profile-spec">Codex · gpt-5.6-sol · Service Tier: Standard · Reasoning: High</span>
              </div>
              <div class="profile-actions" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/></svg>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="agents" class="feature-row reveal">
        <div class="panel">
          <div class="panel-legend">
            <span>Active threads</span><span>Illustration</span>
          </div>
          <div class="threads">
            <div class="thread">
              <span class="dot dot--run" aria-hidden="true"></span>
              <span class="thread-name">coding · auth-refactor</span>
              <span class="thread-model">claude-fable-5</span>
            </div>
            <div class="thread">
              <span class="dot dot--plan" aria-hidden="true"></span>
              <span class="thread-name">Planning · api/routes</span>
              <span class="thread-model">gpt-5.6-sol</span>
            </div>
            <div class="thread">
              <span class="dot dot--wait" aria-hidden="true"></span>
              <span class="thread-name">implementer · issue #482</span>
              <span class="thread-model">gpt-5.6-luna</span>
            </div>
            <div class="thread">
              <span class="dot dot--docs" aria-hidden="true"></span>
              <span class="thread-name">docs · changelog</span>
              <span class="thread-model">grok-4.5</span>
            </div>
          </div>
        </div>

        <div class="feature-copy">
          <h3>Cross-provider agent orchestration</h3>
          <p>
            Spawn a swarm against one branch and supervise every thread in one
            place. The provider is a setting, not a rewrite.
          </p>
          <ul class="dashlist">
            <li><span aria-hidden="true">—</span><span>Sub-agents spawned with the <code class="code-skill">$orchestrate</code> skill</span></li>
            <li><span aria-hidden="true">—</span><span>Git graph, diff and AI auto-commit alongside</span></li>
            <li><span aria-hidden="true">—</span><span>Or straight from the <code>aqqua</code> CLI</span></li>
          </ul>
        </div>
      </div>

      <div id="flows" class="feature-row reveal">
        <div class="feature-copy">
          <h3>Deterministic steps, parameterised prompts</h3>
          <p>
            Describe the pipeline once. Each step runs in its own thread, in
            order, taking parameters and artifacts from the steps before it.
          </p>
          <ul class="dashlist">
            <li><span aria-hidden="true">—</span><span>Reference an earlier step's artifact by name</span></li>
            <li><span aria-hidden="true">—</span><span>Call agent skills inline with <code class="code-skill">$orchestrate</code></span></li>
            <li><span aria-hidden="true">—</span><span>Same input, same run, every time</span></li>
          </ul>
        </div>

        <div class="panel">
          <div class="panel-crumbs">
            <div class="crumbs">
              <span class="crumb">aqqua</span>
              <span class="crumb-sep" aria-hidden="true">›</span>
              <span>New flow</span>
            </div>
            <span class="crumb-hint">esc to close</span>
          </div>

          <div class="flow-title">
            <span>Aqqua coding flow</span>
            <span>Describe the pipeline. Each step runs in its own thread, in order.</span>
          </div>

          <div class="panel-legend">
            <span>Steps</span><span>Reorder</span>
          </div>

          <div class="steps">
            <div class="step">
              <span class="step-index">1</span>
              <div class="step-body">
                <div class="step-head">
                  <span class="step-name">Analysis</span>
                  <span class="step-agent"><span class="dot dot--plan" aria-hidden="true"></span>analysis</span>
                </div>
                <span class="step-prompt">
                  Create an analysis on the current issue <span class="token">issue_id</span> and save it…
                </span>
              </div>
            </div>

            <div class="step is-active">
              <span class="step-index">2</span>
              <div class="step-body">
                <div class="step-head">
                  <span class="step-name">Design</span>
                  <span class="step-agent"><span class="dot dot--docs" aria-hidden="true"></span>designer</span>
                </div>
                <p class="step-prompt step-prompt--full">
                  Grab the <span class="ref-artifact">{"${artifact:Analysis}"}</span> and design the code
                  solution. Analyze the modules affected, use <span class="ref-skill">$orchestrate</span> to
                  spawn sub agents. Use <span class="ref-guide">$codebase-design</span> as guidelines
                </p>
              </div>
            </div>

            <div class="step">
              <span class="step-index">3</span>
              <div class="step-body">
                <div class="step-head">
                  <span class="step-name">Implementation</span>
                  <span class="step-agent"><span class="dot dot--run" aria-hidden="true"></span>review</span>
                </div>
                <span class="step-prompt">
                  Implement code for <span class="token token--artifact">{"${artifact:Design}"}</span>
                </span>
              </div>
            </div>

            <div class="step-add">
              <span class="step-index step-index--ghost" aria-hidden="true">+</span>
              <span>Add step</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="workspace" class="sec-workspace">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow eyebrow--dim">Built in</span>
        <h2>Everything you'd otherwise alt-tab for.</h2>
        <p>
          Reviewing what an agent did shouldn't mean leaving the app that ran
          it. Commits, diffs, history, files and worktrees all live beside the
          thread that produced them.
        </p>
      </div>

      <div class="workspace-grid reveal">
        <div class="cell">
          <span class="cell-mark" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 3v6"/><path d="M12 15v6"/></svg>
          </span>
          <h3>AI auto-commit</h3>
          <p>
            Stage the work and let the agent write the message from the diff
            itself — title, body and scope, no placeholder text.
          </p>
        </div>

        <div class="cell">
          <span class="cell-mark" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v6"/><path d="M9 6h6"/><path d="M9 18h6"/><path d="M4 12h16"/></svg>
          </span>
          <h3>Diff viewer</h3>
          <p>
            Read every change side by side before it lands, file by file,
            without leaving the thread that made it.
          </p>
        </div>

        <div class="cell">
          <span class="cell-mark" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="12" r="2.5"/><path d="M6 8.5v7"/><path d="M8.5 6h4a3 3 0 0 1 3 3v.5"/></svg>
          </span>
          <h3>Git graph and history</h3>
          <p>
            Follow the branch's commit graph in the app — lanes, merges and tags
            — and open any commit's diff beside it.
          </p>
        </div>

        <div class="cell">
          <span class="cell-mark" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h5l2 2h9v12H4Z"/><path d="M4 11h16"/></svg>
          </span>
          <h3>File explorer and editor</h3>
          <p>
            Browse and edit the repository in place. No second window, no
            context switch to check what an agent touched.
          </p>
        </div>

        <div class="cell">
          <span class="cell-mark" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.2"/><circle cx="6" cy="19" r="2.2"/><circle cx="18" cy="19" r="2.2"/><path d="M12 7.2v3.3a2 2 0 0 1-2 2H8a2 2 0 0 0-2 2v2.3"/><path d="M12 10.5a2 2 0 0 0 2 2h2a2 2 0 0 1 2 2v2.3"/></svg>
          </span>
          <h3>Worktree management</h3>
          <p>
            Give each agent its own worktree so parallel work never collides.
            Create, switch and prune them from the app or the CLI.
          </p>
        </div>

        <div class="cell">
          <span class="cell-mark" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="12.5" rx="1.8"/><path d="M8 20h8"/><path d="M12 16.5V20"/></svg>
          </span>
          <h3>Every platform</h3>
          <p>
            macOS, Windows and Linux from the same build. Same app, same
            threads, whichever machine you sit down at.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="open" class="sec-open">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Open source</span>
        <h2>A fork is a first‑class way to use this.</h2>
        <p>
          There is no hosted tier holding the good parts back. The repository is
          the product — clone it, change it, ship it under your own name.
        </p>
      </div>

      <div class="open-ledger reveal">
        <div class="open-row">
          <span class="open-row-num" aria-hidden="true">01</span>
          <h3>Change the UI</h3>
          <p>
            Every surface is yours to restyle or rip out. Not a theme API, not a
            plugin sandbox — the same source we build the release from.
          </p>
        </div>

        <div class="open-row">
          <span class="open-row-num" aria-hidden="true">02</span>
          <h3>Add a provider</h3>
          <p>
            A driver is a settings schema and an icon. Point aqqua at whatever
            harness you run internally and it lands in the same picker.
          </p>
        </div>

        <div class="open-row">
          <span class="open-row-num" aria-hidden="true">03</span>
          <h3>Ship your own build</h3>
          <p>
            Run it in-house behind your own signing keys, or hand it out under
            your name. MIT asks for nothing back.
          </p>
        </div>
      </div>

      <div class="open-footer reveal">
        <p class="open-license">
          MIT licensed, top to bottom · A community fork of {UPSTREAM_NAME}
        </p>

        <div class="open-actions">
          <a class="btn btn-primary" href={GITHUB_FORK_URL} target="_blank" rel="noreferrer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="5" r="2.2"/><circle cx="18" cy="5" r="2.2"/><circle cx="12" cy="19" r="2.2"/><path d="M6 7.2v2A3 3 0 0 0 9 12.2h6A3 3 0 0 0 18 9.2v-2M12 14v2.8"/></svg>
            Fork on GitHub
          </a>
          <a class="open-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
            Browse source
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="download" class="sec-cta">
    <div class="container cta-grid">
      <div class="cta-lede">
        <span class="eyebrow">Get aqqua</span>
        <h2 class="cta-title">Install it, then hand over the backlog.</h2>
        <p class="cta-sub">
          One download, no account, no server to point it at. Sign in to the
          harnesses you already pay for and the workspace is yours.
        </p>
        <p class="cta-release">
          <span id="cta-release-label">Checking the latest release…</span>
          <a href={RELEASES_URL} target="_blank" rel="noreferrer">
            All releases
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </p>
      </div>

      <div class="cta-builds">
        {
          BUILDS.map((build) => (
            <a
              class="build"
              href={RELEASES_URL}
              data-os={build.os}
              data-asset={build.asset}
              data-detect={build.detect ? "" : null}
            >
              <span class="build-mark" aria-hidden="true">
                <PlatformGlyph platform={build.os} size={16} />
              </span>
              <span class="build-label">
                <span class="build-os">{build.name}</span>
                <span class="build-arch">{build.arch}</span>
              </span>
              <span class="build-here">On this machine</span>
              <span class="build-fmt">{build.format}</span>
              <svg class="build-go" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v13M6.5 11.5 12 17l5.5-5.5M5 20h14"/></svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string; arch?: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) {
      return { os: "mac", label: "Download for macOS", arch: "arm64" };
    }
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      const preferred = assets.find((a) => a.name.endsWith(`-${platform.arch}.dmg`));
      const fallback = assets.find((a) => a.name.endsWith(".dmg"));
      return (preferred ?? fallback)?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith(".AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function init() {
    const button = document.getElementById("download-btn") as HTMLAnchorElement | null;
    const label = document.getElementById("download-label");
    const releaseLabel = document.getElementById("cta-release-label");
    const builds = document.querySelectorAll<HTMLAnchorElement>(".build[data-asset]");

    const platform = detectPlatform();
    if (platform) {
      document.documentElement.dataset.platform = platform.os;
      if (label) label.textContent = platform.label;
    }

    let release;
    try {
      release = await fetchLatestRelease();
    } catch {
      if (releaseLabel) releaseLabel.textContent = "Latest build on GitHub";
      return;
    }

    if (releaseLabel && release.tag_name) {
      releaseLabel.textContent = `Latest release · ${release.tag_name}`;
    }

    const assets = release.assets ?? [];

    for (const build of builds) {
      const suffix = build.dataset.asset;
      const match = suffix ? assets.find((a) => a.name.endsWith(`-${suffix}`)) : undefined;
      if (match) build.href = match.browser_download_url;
    }

    if (button && platform) {
      const url = pickAsset(assets, platform);
      if (url) {
        button.href = url;
        button.removeAttribute("target");
        button.removeAttribute("rel");
      }
    }
  }

  init();
</script>

