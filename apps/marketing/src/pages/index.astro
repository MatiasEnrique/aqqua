---
/*
 * aqqua landing page.
 *
 * Aesthetic direction — "editorial instrument" on the product's own palette:
 * the app's ink ramp for every surface, its brand ink on the paper band, the
 * dusk surf painting as imagery only. IBM Plex Sans carries every display
 * moment and Inter every working one, exactly as in the app.
 *
 * Structure is deliberately un-uniform. Each band gets its own shape — a
 * headless ticker, a bleeding product plate with a numbered step rail, a
 * centred cinema block, an asymmetric bento, a bare ledger, a warm-paper
 * manifesto, a split FAQ, a photographic close — so the page reads as chapters
 * rather than a stack of identical header-plus-grid sections.
 */
import * as NodeFS from "node:fs";
import * as NodePath from "node:path";

import BentoCell from "../components/BentoCell.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Faq from "../components/Faq.astro";
import GithubGlyph from "../components/GithubGlyph.astro";
import PlatformGlyph from "../components/PlatformGlyph.astro";
import ProviderTicker from "../components/ProviderTicker.astro";
import FlowEditorDialogDemo from "../components/demos/FlowEditorDialogDemo.astro";
import ProductDemo from "../components/demos/ProductDemo.astro";
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import { GITHUB_FORK_URL, GITHUB_REPOSITORY_URL, UPSTREAM_NAME, UPSTREAM_URL } from "../lib/site";

const HARNESSES = [
  { name: "Claude", product: "Claude Code", mark: "/harnesses/claude-ai-icon.svg" },
  { name: "Codex", product: "Codex CLI", mark: "/harnesses/openai_dark.svg" },
  { name: "Grok", product: "Grok CLI", mark: "/harnesses/grok-dark.svg" },
  { name: "opencode", product: "OpenCode", mark: "/harnesses/opencode-dark.svg" },
  { name: "Cursor", product: "Cursor", mark: "/harnesses/cursor_light.svg" },
  { name: "pi", product: "pi coding agent", mark: "/harnesses/pi.svg" },
] as const;

const BUILDS = [
  { os: "mac", name: "macOS", arch: "Apple Silicon", format: "dmg", asset: "arm64.dmg", detect: true },
  { os: "mac", name: "macOS", arch: "Intel", format: "dmg", asset: "x64.dmg", detect: false },
  { os: "win", name: "Windows", arch: "10 and 11, x64", format: "exe", asset: "x64.exe", detect: true },
  { os: "linux", name: "Linux", arch: "x86_64", format: "AppImage", asset: "x86_64.AppImage", detect: true },
] as const;

/** The flow in the editor beside it: Plan → Implement → Review, then Done. */
const FLOW_STEPS = [
  {
    name: "Plan",
    body: "The planning agent opens its own thread on the exact provider and model you pinned to it, and saves its plan as a named artifact.",
  },
  {
    name: "Implement",
    body: "The next agent starts clean. It reads the plan by name, works the task's own branch and worktree, and never inherits the last step's context.",
  },
  {
    name: "Review",
    body: "Mark a step to pause and the task waits with everything written down. Resume once you've read the work — or don't, and it holds.",
  },
] as const;

const WORKSPACE = [
  {
    title: "AI commit messages",
    body: "Stage the work and let the agent write the message from the diff itself — title, body and scope, no placeholder text.",
  },
  {
    title: "Diff viewer",
    body: "Read every change side by side before it lands, file by file, without leaving the thread that made it.",
  },
  {
    title: "File explorer and editor",
    body: "Browse and edit the repository in place. No second window to check what an agent touched.",
  },
  {
    title: "Remote access and mobile",
    body: "Reach the same threads from another machine or the phone app while the agents keep running on your hardware.",
  },
  {
    title: "Command palette and keybindings",
    body: "Every surface is one chord away, and the bindings are yours to rewrite when they don't match your muscle memory.",
  },
  {
    title: "Every platform",
    body: "macOS, Windows and Linux from the same build. Same app, same threads, whichever machine you sit down at.",
  },
] as const;

const FAQS = [
  {
    q: "Is aqqua actually free, or is this the free tier?",
    a: "Actually free. The repository is the product — MIT licensed, top to bottom, with no hosted tier holding features back and nothing to upgrade to. Clone it, change it, ship your own build under your own name.",
  },
  {
    q: "Do I need API keys or a billing account?",
    a: "No. aqqua drives the harnesses you already sign in to — Claude Code, Codex CLI, Grok, OpenCode, Cursor and pi — on the plans you already pay for. Nothing is metered, resold or routed through us.",
  },
  {
    q: "Does my code or my prompts leave the machine?",
    a: "No. Everything runs locally against your own checkouts, and the app talks to the same provider endpoints your CLI already does. Usage scanning stays off until you switch it on, and the logs never leave the machine.",
  },
  {
    q: "What does “a card per worktree” actually mean?",
    a: "Each card owns a real git branch and a real git worktree on disk. Agents working different cards never share a checkout, so a swarm can run in parallel without three threads fighting over the same working tree.",
  },
  {
    q: "How do flows differ from just prompting an agent repeatedly?",
    a: "A flow is the pipeline written down once: ordered steps, each with its own prompt, its own pinned model and its own fresh thread. Steps take parameters and named artifacts from the steps before them, so every card takes the same path instead of whatever you happened to type that morning.",
  },
  {
    q: "Can I mix providers on the same change?",
    a: 'Yes — that is the point of speaking ACP. Spawn agents with the <code>$orchestrate</code> skill or the <code>aqqua agent spawn</code> CLI and give each lane its own provider, model and reasoning level, all against one branch.',
  },
  {
    q: "Which platforms are supported?",
    a: "macOS on Apple Silicon and Intel, Windows 10 and 11 on x64, and Linux x86_64 as an AppImage — all cut from the same build. There is a mobile app for reaching threads that are running back home.",
  },
  {
    q: `How does this relate to ${UPSTREAM_NAME}?`,
    a: `aqqua is a community fork of ${UPSTREAM_NAME}, kept MIT and shipped as its own builds. Forking is a supported way to use it: adding a provider is a settings schema and an icon, and every surface is yours to restyle or rip out.`,
  },
] as const;

const OPEN_ROWS = [
  {
    title: "Change the UI",
    body: "Every surface is yours to restyle or rip out. Not a theme API, not a plugin sandbox — the same source we build the release from.",
  },
  {
    title: "Add a provider",
    body: "A driver is a settings schema and an icon. Point aqqua at whatever harness you run internally and it lands in the same picker.",
  },
  {
    title: "Ship your own build",
    body: "Run it in house behind your own signing keys, or hand it out under your name. MIT asks for nothing back.",
  },
] as const;

/**
 * The tagline reveal band. Split into words at build time so each one can flip
 * from muted to full colour as it crosses the scroll trigger; the second line
 * carries the coral accent.
 */
const TAGLINE_LINES = [
  { words: ["Bring", "the", "subscription"], accent: false },
  { words: ["you", "already", "pay", "for."], accent: true },
] as const;

const TAGLINE_TEXT = TAGLINE_LINES.map((line) => line.words.join(" ")).join(" ");

/** FAQ answers reused as FAQPage JSON-LD, with markup stripped. */
const FAQ_SCHEMA = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQS.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a.replace(/<[^>]+>/g, "") },
  })),
});

const publicFile = (path: string) =>
  NodeFS.existsSync(NodePath.join(process.cwd(), "public", path)) ? `/${path}` : null;

const heroFile = (name: string) => publicFile(`hero/${name}`);

const HERO_WIDTHS = [1680, 2200, 2880, 3840, 5250];
const HERO_PORTRAIT_WIDTHS = [1200, 1920];

const HERO_SIZES = "max(100vw, min(240vh, 2625px))";

const HERO_PORTRAIT_SIZES = "max(100vw, 75vh)";

const srcset = (prefix: string, widths: number[], ext: string) =>
  widths
    .map((w) => [heroFile(`${prefix}-${w}.${ext}`), w] as const)
    .filter(([src]) => src !== null)
    .map(([src, w]) => `${src} ${w}w`)
    .join(", ");

const heroWideJpeg = srcset("hero", HERO_WIDTHS, "jpg");
const heroWideWebp = srcset("hero", HERO_WIDTHS, "webp");
const heroPortraitJpeg = srcset("hero-mobile", HERO_PORTRAIT_WIDTHS, "jpg");
const heroPortraitWebp = srcset("hero-mobile", HERO_PORTRAIT_WIDTHS, "webp");

const heroWide = HERO_WIDTHS.map((w) => heroFile(`hero-${w}.jpg`))
  .filter((src) => src !== null)
  .at(-1);

const closeShot = heroFile("hero-2200.webp") ?? heroFile("hero-2200.jpg");
---

<Layout navOverlay>
  <!-- ── 1 · Hero ─────────────────────────────────────────────────────── -->
  <section class="hero" id="top">
    {
      heroWide && (
        <picture class="hero-media">
          {heroPortraitWebp && (
            <source
              media="(max-aspect-ratio: 3/4)"
              type="image/webp"
              srcset={heroPortraitWebp}
              sizes={HERO_PORTRAIT_SIZES}
              width="1200"
              height="1600"
            />
          )}
          {heroPortraitJpeg && (
            <source
              media="(max-aspect-ratio: 3/4)"
              srcset={heroPortraitJpeg}
              sizes={HERO_PORTRAIT_SIZES}
              width="1200"
              height="1600"
            />
          )}
          {heroWideWebp && (
            <source type="image/webp" srcset={heroWideWebp} sizes={HERO_SIZES} width="2880" height="1207" />
          )}
          <source srcset={heroWideJpeg} sizes={HERO_SIZES} width="2880" height="1207" />
          <img
            src={heroWide}
            alt="A surfer with a laptop riding the shoulder of a long wave at dusk"
            width="2880"
            height="1207"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      )
    }
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-scrim-edge" aria-hidden="true"></div>

    <div class="hero-content">
      <div class="hero-block">
        <span class="hero-eyebrow">Agentic development environment</span>

        <h1 class="hero-title display display-wash">
          Surf your backlog<br />with Aqqua ADE
        </h1>

        <a class="hero-fork" href={UPSTREAM_URL} target="_blank" rel="noreferrer">
          A community fork of {UPSTREAM_NAME}
        </a>

        <div class="hero-actions">
          <DownloadButton id="hero-download" labelId="hero-download-label" href={RELEASES_URL} />
          <a class="btn btn-outline btn-lg hero-ghost" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
            <GithubGlyph size={15} />
            Read the source
          </a>
        </div>

        <ul class="hero-proof">
          <li>100% free and open source</li>
          <li>No account, no API keys</li>
          <li>macOS · Windows · Linux</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── 2 · Provider band: the tagline reveal ────────────────────────── -->
  <section id="providers" class="band tone-deep grain">
    <div class="container band-claim reveal">
      <p class="band-line display" data-tagline aria-label={TAGLINE_TEXT}>
        {
          TAGLINE_LINES.map((line) => (
            <span class:list={["tagline-line", line.accent && "tagline-line--accent"]} aria-hidden="true">
              {line.words.map((word) => (
                <span class="tagline-word">{word}</span>
              ))}
            </span>
          ))
        }
      </p>
      <p class="band-note">
        aqqua speaks ACP, so every harness lands in the same interface. Nothing
        is metered, resold or routed through us — your prompts go straight to
        your provider, and your code never leaves your machine.
      </p>
    </div>

    <ProviderTicker harnesses={HARNESSES} />
  </section>

  <!-- ── 3 · Orchestration: the cinema block ──────────────────────────── -->
  <section id="agents" class="sec-agents tone-ink">
    <div class="container agents-head reveal">
      <span class="eyebrow">Three providers, one branch</span>
      <h2 class="display agents-title">Agent orchestration <em>across providers</em></h2>
      <p class="lede agents-lede">
        Spawn a swarm against a single change and supervise every thread in one
        place. Below, Claude runs the orchestration and hands one lane to Codex
        and one to pi — the provider is a setting, not a rewrite.
      </p>
    </div>

    <div class="container agents-stage reveal">
      <ProductDemo slug="orchestration" class="agents-media" />
    </div>

    <div class="container agents-notes reveal">
      <div class="note">
        <span class="note-idx" aria-hidden="true">01</span>
        <p>
          Agents spawned with the <code>$orchestrate</code> skill, or straight
          from the <code>aqqua agent spawn</code> CLI.
        </p>
      </div>
      <div class="note">
        <span class="note-idx" aria-hidden="true">02</span>
        <p>
          Every lane pinned to its own provider instance, model and reasoning
          level — chosen from what that model actually advertises.
        </p>
      </div>
      <div class="note">
        <span class="note-idx" aria-hidden="true">03</span>
        <p>
          An orchestrator keeps its whole agent tree behind one numbered
          control, so a large delegation never widens the tab strip.
        </p>
      </div>
    </div>
  </section>

  <!-- ── 4 · Flows: the product plate ─────────────────────────────────── -->
  <section id="flows" class="sec-flows tone-deep grain">
    <div class="container-wide flows-grid">
      <div class="flows-copy reveal">
        <span class="eyebrow">A flow, before launch</span>
        <h2 class="display flows-title">Define your workflow.</h2>
        <p class="lede flows-lede">
          Flows make your workflow native to aqqua: ordered steps, written down
          once. Each step runs a specific agent — its own prompt, provider and
          model — hands its artifact to the next, and keeps going while you
          read something else.
        </p>

        <ol class="steps">
          {
            FLOW_STEPS.map((step, index) => (
              <li class="step">
                <span class="step-num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <div class="step-copy">
                  <h3>{step.name}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="steps-foot">
          Same handoff contract, every run. Each task carries its own branch
          and worktree the whole way, so two tasks never fight over one
          checkout.
        </p>

        <div class="flows-actions">
          <DownloadButton id="flows-download" labelId="flows-download-label" href={RELEASES_URL} />
          <a class="flows-link" href="#features">
            See the rest of the workspace
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5.5 12.5 12 19l6.5-6.5"/></svg>
          </a>
        </div>
      </div>

      <div class="reveal">
        <FlowEditorDialogDemo />
      </div>
    </div>
  </section>

  <!-- ── 5 · Feature bento ────────────────────────────────────────────── -->
  <section id="features" class="sec-features tone-ink">
    <div class="container">
      <div class="split-head reveal">
        <span class="eyebrow">Core features</span>
        <h2 class="display split-title">
          One window for <em>the whole loop.</em>
        </h2>
      </div>

      <div class="bento">
        <BentoCell
          id="worktrees"
          span={7}
          kicker="Worktrees"
          title="A card per worktree, a tab per conversation"
          body="Each card is a real branch and worktree; each conversation is a tab beneath it. Branch, checkout type and highest priority state ride on the card's face, and merged pull requests show their number — the whole swarm readable at a glance."
        >
          <ProductDemo slug="worktree-tabs" />
        </BentoCell>

        <BentoCell
          span={5}
          kicker="Queue"
          title="Queue the next three messages"
          body="Submitting during a running turn queues the message instead of interrupting it. aqqua sends them one turn at a time — steer one in early if it can't wait. The queue is durable thread state, so it survives reconnects across web, desktop and mobile."
        >
          <ProductDemo slug="message-queue" />
        </BentoCell>

        <BentoCell
          span={5}
          kicker="History"
          title="Git graph and history"
          body="Follow the branch's commit graph in the app — lanes, merges and tags — and open any commit's full diff beside it. aqqua reads refs already in the repository and never fetches behind your back."
        >
          <ProductDemo slug="git-graph" />
        </BentoCell>

        <BentoCell
          span={7}
          kicker="Review"
          title="Pull requests, without leaving"
          body="Watch the change request for the branch you have checked out: state, base and head, aggregate CI and every individual check. Merge, arm auto merge, close or reopen from the same panel — and threads settle themselves once the PR lands."
        >
          <ProductDemo slug="pull-request" />
        </BentoCell>

        <BentoCell
          span={4}
          kicker="Spend"
          title="Know what the agents cost"
          body="Live rate limit gauges plus a historical ledger — tokens, turns, cache share and estimated cost by model and project. Scanning stays off until you turn it on, and the logs never leave the machine."
        >
          <ProductDemo slug="usage" />
        </BentoCell>

        <BentoCell
          span={4}
          kicker="Continuity"
          title="Resume a terminal conversation"
          body="Started something in the Claude Code or Codex CLI? Type <code>/resume</code> in a new draft and pick it up here. The thread adopts the provider session and keeps the earlier transcript one click away."
        >
          <ProductDemo slug="resume-cli" />
        </BentoCell>

        <BentoCell
          span={4}
          kicker="Focus"
          title="Scope the sidebar to what you're on"
          body="Run many projects from one window and narrow the registry to the ones that matter right now. Projects group their worktree cards and collapse independently."
        >
          <ProductDemo slug="project-scope" />
        </BentoCell>
      </div>
    </div>
  </section>

  <!-- ── 6 · Workspace ledger ─────────────────────────────────────────── -->
  <section id="workspace" class="sec-workspace tone-deep grain">
    <div class="container ledger-grid">
      <div class="ledger-aside reveal">
        <span class="eyebrow">Built in</span>
        <h2 class="display ledger-title">
          Everything you kept <em>a second window</em> for.
        </h2>
        <p class="ledger-sub">
          Reviewing what an agent did shouldn't mean leaving the app that ran
          it. Commits, diffs, files and the rest of the workspace live beside
          the thread that produced them.
        </p>
      </div>

      <ul class="ledger reveal">
        {
          WORKSPACE.map((item, index) => (
            <li class="ledger-row">
              <span class="ledger-idx" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── 7 · Open source manifesto, on paper ──────────────────────────────
       The one light band on the page. Dropping to warm paper here is what
       stops the dark sections reading as a single continuous run. -->
  <section id="open" class="sec-open tone-paper">
    <div class="container">
      <div class="open-head reveal">
        <span class="eyebrow">Open source</span>
        <h2 class="display open-title">
          Yours to fork,<br /><em>rename and ship.</em>
        </h2>
        <p class="lede open-lede">
          There is no hosted tier holding the good parts back. The repository is
          the product — clone it, change it, ship it under your own name.
        </p>
      </div>

      <div class="open-ledger reveal">
        {
          OPEN_ROWS.map((row, index) => (
            <div class="open-row">
              <span class="open-row-num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3>{row.title}</h3>
              <p>{row.body}</p>
            </div>
          ))
        }
      </div>

      <div class="open-footer reveal">
        <p class="open-license">
          MIT licensed, top to bottom · A community fork of {UPSTREAM_NAME}
        </p>

        <div class="open-actions">
          <a class="btn btn-outline" href={GITHUB_FORK_URL} target="_blank" rel="noreferrer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="5" r="2.2"/><circle cx="18" cy="5" r="2.2"/><circle cx="12" cy="19" r="2.2"/><path d="M6 7.2v2A3 3 0 0 0 9 12.2h6A3 3 0 0 0 18 9.2v-2M12 14v2.8"/></svg>
            Fork on GitHub
          </a>
          <a class="open-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
            Browse source
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 8 · FAQ ──────────────────────────────────────────────────────── -->
  <section id="faq" class="sec-faq tone-deep grain">
    <div class="container faq-grid">
      <div class="faq-aside reveal">
        <span class="eyebrow">Questions</span>
        <h2 class="display faq-title">Before you<br />download.</h2>
        <p class="faq-sub">
          Still stuck? The repository's issues and the Discord are both open —
          and so is every line of the answer.
        </p>
      </div>

      <div class="faq-body reveal">
        <Faq items={FAQS} />
      </div>
    </div>
  </section>

  <!-- ── 9 · Close ───────────────────────────────────────────────────── -->
  <section id="download" class="sec-close">
    {closeShot && <img class="close-media" src={closeShot} alt="" width="2200" height="922" loading="lazy" decoding="async" />}
    <div class="close-scrim" aria-hidden="true"></div>

    <div class="container close-inner">
      <div class="close-lede reveal">
        <span class="eyebrow">Get aqqua</span>
        <h2 class="display close-title">Take the wave.</h2>
        <p class="close-sub">
          One download, no account, no server to point it at. Sign in to the
          harnesses you already pay for and the workspace is yours.
        </p>

        <div class="close-actions">
          <DownloadButton id="cta-download" labelId="cta-download-label" href={RELEASES_URL} />
          <a class="btn btn-outline btn-lg" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">
            <GithubGlyph size={15} />
            Star on GitHub
          </a>
        </div>

        <p class="close-release">
          <span id="cta-release-label">Checking the latest release…</span>
          <a href={RELEASES_URL} target="_blank" rel="noreferrer">
            All releases
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </p>
      </div>

      <div class="close-builds reveal">
        {
          BUILDS.map((build) => (
            <a
              class="build"
              href={RELEASES_URL}
              data-os={build.os}
              data-asset={build.asset}
              data-detect={build.detect ? "" : null}
            >
              <span class="build-mark" aria-hidden="true">
                <PlatformGlyph platform={build.os} size={16} />
              </span>
              <span class="build-label">
                <span class="build-os">{build.name}</span>
                <span class="build-arch">{build.arch}</span>
              </span>
              <span class="build-here">On this machine</span>
              <span class="build-fmt">{build.format}</span>
              <svg class="build-go" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v13M6.5 11.5 12 17l5.5-5.5M5 20h14"/></svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={FAQ_SCHEMA} />
</Layout>

<script>
  import { initDemos } from "../scripts/demos";
  import { fetchLatestRelease, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string; arch?: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) {
      return { os: "mac", label: "Download for macOS", arch: "arm64" };
    }
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      const preferred = assets.find((a) => a.name.endsWith(`-${platform.arch}.dmg`));
      const fallback = assets.find((a) => a.name.endsWith(".dmg"));
      return (preferred ?? fallback)?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith(".AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function init() {
    // The page carries several download buttons; they all resolve together.
    const buttons = document.querySelectorAll<HTMLAnchorElement>("a[data-download]");
    const labels = document.querySelectorAll<HTMLElement>("[data-download-label]");
    const releaseLabel = document.getElementById("cta-release-label");
    const builds = document.querySelectorAll<HTMLAnchorElement>(".build[data-asset]");

    const platform = detectPlatform();
    if (platform) {
      document.documentElement.dataset.platform = platform.os;
      for (const label of labels) label.textContent = platform.label;
    }

    let release;
    try {
      release = await fetchLatestRelease();
    } catch {
      if (releaseLabel) releaseLabel.textContent = "Latest build on GitHub";
      return;
    }

    if (releaseLabel && release.tag_name) {
      releaseLabel.textContent = `Latest release · ${release.tag_name}`;
    }

    const assets = release.assets ?? [];

    for (const build of builds) {
      const suffix = build.dataset.asset;
      const match = suffix ? assets.find((a) => a.name.endsWith(`-${suffix}`)) : undefined;
      if (match) build.href = match.browser_download_url;
    }

    if (platform) {
      const url = pickAsset(assets, platform);
      if (url) {
        for (const button of buttons) {
          button.href = url;
          button.removeAttribute("target");
          button.removeAttribute("rel");
        }
      }
    }
  }

  initDemos();
  init();
</script>

