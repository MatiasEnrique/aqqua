---
import BrandMark from "../components/BrandMark.astro";
import GithubGlyph from "../components/GithubGlyph.astro";
import {
  GITHUB_REPOSITORY,
  GITHUB_REPOSITORY_URL,
  SITE_OPERATOR,
  UPSTREAM_NAME,
  UPSTREAM_URL,
} from "../lib/site";
import "../styles/aqqua.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  navOverlay?: boolean;
}

const {
  title = "aqqua",
  description = "aqqua — The open-source control plane for coding agents.",
  pageClass,
  navOverlay = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#181818" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Inter:opsz,wght@14..32,400..700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={["page", pageClass, navOverlay && "page--nav-overlay"]}>
      <nav class="nav" aria-label="Primary">
        <div class="nav-brand">
          <a href="/" aria-label="aqqua home" class="nav-crest">
            <BrandMark height={20} />
          </a>
          <a
            class="nav-repo"
            href={GITHUB_REPOSITORY_URL}
            target="_blank"
            rel="noreferrer"
            aria-label={`aqqua repository on GitHub — ${GITHUB_REPOSITORY}`}
          >
            <GithubGlyph />
            <span>{GITHUB_REPOSITORY}</span>
          </a>
        </div>

        <div class="nav-links">
          <a href="/#providers">Providers</a>
          <a href="/#agents">Agents</a>
          <a href="/#features">Features</a>
          <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">GitHub</a>
        </div>

        <div class="nav-actions">
          <a class="btn btn-outline" href="/download">Download</a>
        </div>
      </nav>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-inner">
          <div class="footer-brand">
            <BrandMark height={20} />
            <span>
              &copy; {new Date().getFullYear()} {SITE_OPERATOR} · MIT licensed · A community fork of{" "}
              <a href={UPSTREAM_URL} target="_blank" rel="noreferrer">{UPSTREAM_NAME}</a>
            </span>
          </div>
          <div class="footer-links">
            <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noreferrer">GitHub</a>
            <a href="https://discord.gg/jn4EGJjrvv" target="_blank" rel="noreferrer">Discord</a>
            <a href="/download">Download</a>
            <a href="/terms-of-service">Terms</a>
            <a href="/privacy-policy">Privacy</a>
            <a href="/security-policy">Security</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .page {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  .nav {
    position: relative;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding: var(--gutter-y-nav) var(--gutter-x);
  }

  .page--nav-overlay .nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
  }

  .nav-brand {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-crest {
    display: block;
    color: var(--text-primary);
  }

  .nav-repo {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: var(--space-2);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: var(--text-12);
    line-height: var(--leading-12);
    transition: color var(--duration-ui) var(--ease-aqqua);
  }

  .nav-repo:hover {
    color: var(--text-primary);
  }

  .nav-repo:active {
    transform: translateY(var(--press-nudge));
  }

  .nav-links {
    display: flex;
    align-items: center;
    align-self: center;
    gap: clamp(16px, 2.4vw, 32px);
    font-family: var(--font-ui);
    font-size: var(--text-14);
    line-height: var(--leading-14);
    font-weight: var(--weight-medium);
  }

  .nav-links a {
    color: var(--text-nav);
    transition: color var(--duration-ui) var(--ease-aqqua);
  }

  .nav-links a:hover {
    color: var(--text-primary);
  }

  .nav-links a:active {
    transform: translateY(var(--press-nudge));
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .footer {
    margin-top: auto;
    border-top: 1px solid var(--border-hairline);
    padding: var(--space-12) 0 var(--space-8);
  }

  .footer-inner {
    max-width: var(--measure-page);
    margin: 0 auto;
    padding: 0 var(--gutter-x);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-12);
    line-height: var(--leading-12);
    color: var(--text-secondary);
  }

  .footer-brand :global(svg) {
    color: var(--text-secondary);
    flex: none;
  }

  .footer-brand a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--aq-white-40);
    transition: var(--transition-ui);
  }

  .footer-brand a:hover {
    color: var(--text-primary);
    text-decoration-color: var(--text-primary);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-6);
  }

  .footer-links a {
    font-size: var(--text-14);
    line-height: var(--leading-14);
    color: var(--text-secondary);
    transition: color var(--duration-ui) var(--ease-aqqua);
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }

  .footer-links a:active {
    transform: translateY(var(--press-nudge));
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .legal-document-page .nav {
      display: none;
    }

    .footer {
      padding-bottom: max(var(--space-8), env(safe-area-inset-bottom));
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-8);
    }

    .footer-links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      gap: 14px var(--space-6);
      justify-content: initial;
    }
  }

  @media (max-width: 480px) {
    .nav-repo {
      display: none;
    }
  }
</style>
