---
/**
 * Live rate-limit gauges plus the 42-day activity heatmap from the Usage page.
 *
 * Bars scale from their left edge and the heatmap fades in per column, so the
 * whole demo animates transform and opacity only.
 */
const GAUGES = [
  { provider: "Claude", window: "5-hour", pct: 62 },
  { provider: "Codex", window: "weekly", pct: 34 },
] as const;

// Six weeks of deterministic activity, 0-4 per day. Fixed so builds stay stable.
const HEATMAP = [
  [1, 3, 2, 4, 0, 2, 1],
  [2, 4, 3, 3, 1, 0, 2],
  [0, 2, 4, 4, 3, 1, 0],
  [3, 3, 1, 2, 4, 2, 1],
  [1, 4, 4, 3, 2, 3, 0],
  [2, 1, 3, 4, 4, 2, 2],
] as const;
---

<div class="dm usage" data-demo>
  <div class="dm-bar">
    <span class="dm-legend">Usage</span>
    <span class="dm-spacer"></span>
    <span class="dm-chip">this environment</span>
  </div>

  <div class="gauges">
    {
      GAUGES.map((gauge, index) => (
        <div class="gauge" style={`--i:${index}; --pct:${gauge.pct}%`}>
          <span class="gauge-head">
            <span class="dm-title gauge-name">{gauge.provider}</span>
            <span class="dm-sub">{gauge.window}</span>
            <span class="dm-spacer" />
            <span class="dm-sub gauge-pct">{gauge.pct}&#37;</span>
          </span>
          <span class="track">
            <span class="fill" />
          </span>
        </div>
      ))
    }
  </div>

  <div class="heat">
    <div class="heat-left">
      <span class="dm-legend">42 days</span>
      <div class="grid">
        {
          HEATMAP.map((week, weekIndex) => (
            <div class="week" style={`--w:${weekIndex}`}>
              {week.map((level) => <span class={`cell l${level}`} />)}
            </div>
          ))
        }
      </div>
    </div>

    <div class="totals">
      <span><b>4.2M</b> tokens</span>
      <span><b>318</b> turns</span>
      <span><b>61&#37;</b> cached</span>
    </div>
  </div>
</div>

<style>
  .gauges {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px 14px 4px;
  }

  .gauge-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 7px;
  }

  .gauge-name {
    flex: none;
    font-size: 12.5px;
    font-weight: var(--weight-medium);
  }

  .gauge-pct {
    font-variant-numeric: tabular-nums;
  }

  .track {
    display: block;
    height: 5px;
    border-radius: var(--radius-pill);
    background: var(--aq-white-08);
    overflow: hidden;
  }

  /*
   * Width is set statically so the bar reads correctly with animation off; the
   * keyframes only scale it in from the left.
   */
  .fill {
    display: block;
    width: var(--pct);
    height: 100%;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.55), var(--aq-white));
    transform-origin: left center;
    animation: usage-fill 7s var(--ease-aqqua) infinite;
    animation-delay: calc(var(--i) * 0.35s);
  }

  .heat {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding: 16px 14px 14px;
  }

  .heat-left {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .grid {
    display: flex;
    gap: 3px;
  }

  /*
   * Six week-columns of seven square days. Fixed cell size rather than a
   * stretched flex track, otherwise 42 cells across a wide card read as bars.
   */
  .week {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: none;
    animation: usage-week 7s var(--ease-aqqua) infinite;
    animation-delay: calc(var(--w) * 0.12s);
  }

  .cell {
    width: 13px;
    height: 13px;
    border-radius: 2px;
    background: var(--aq-white-08);
  }

  .l1 { background: rgba(255, 255, 255, 0.22); }
  .l2 { background: rgba(255, 255, 255, 0.42); }
  .l3 { background: rgba(255, 255, 255, 0.64); }
  .l4 { background: rgba(214, 232, 243, 0.92); }

  .totals {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
    font-size: 11.5px;
    line-height: 16px;
    color: var(--aq-white-55);
    white-space: nowrap;
  }

  .totals b {
    color: var(--text-strong);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  @keyframes usage-fill {
    0% { transform: scaleX(0); }
    38%, 100% { transform: scaleX(1); }
  }

  @keyframes usage-week {
    0% { opacity: 0.15; }
    34%, 100% { opacity: 1; }
  }
</style>
