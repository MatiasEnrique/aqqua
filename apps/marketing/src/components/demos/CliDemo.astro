---
/**
 * `aqqua agent` — the orchestration CLI, replayed as a terminal session.
 *
 * A terminal is monospace text, so unlike the app demos this one is not a
 * likeness: every command, flag and output line below is exactly what
 * `apps/server/src/cli/agent.ts` accepts and prints. The catalog rows come from
 * `formatModelLine()`, the spawn confirmations from `formatSpawnStarted()`, and
 * the `list` rows from `${status.padEnd(11)} ${threadId}  ${title}`.
 *
 * The transcript is the base state: with every `animation:` declaration removed
 * the whole session renders, finished and readable. Typing is decoration layered
 * on top — a stepped `clip-path` reveal, never an animated width — and each line
 * carries an absolute `--at` offset so one shared keyframe pair drives the whole
 * replay without per-line keyframes or drift.
 *
 * Long lines are handled deliberately: the `reasoning=` suffix and the
 * "Await it with:" tail are dropped until the card is wide enough to hold them,
 * and the body font is sized from the container so the widest surviving line
 * (74 columns) fits. Anything past that clips — the demo never scrolls sideways.
 */
interface Seg {
  readonly t: string;
  readonly c?: string;
}

interface Line {
  /** Seconds into the replay at which this line appears. */
  readonly at: number;
  readonly segs: readonly Seg[];
  /** Present on lines that are typed rather than printed. */
  readonly type?: { readonly dur: number; readonly n: number };
  readonly prompt?: boolean;
  /** Starts a new block, i.e. a blank line above it. */
  readonly sp?: boolean;
}

const LINES: readonly Line[] = [
