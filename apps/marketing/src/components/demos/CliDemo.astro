---

<div class="dm cli" data-demo>
  <div class="dm-bar">
    <span class="dm-legend">Orchestrator shell</span>
    <span class="dm-spacer"></span>
    <span class="dm-branch">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="6" cy="6" r="2.5"></circle><circle cx="6" cy="18" r="2.5"></circle><circle cx="18" cy="9" r="2.5"></circle>
        <path d="M6 8.5v7"></path><path d="M8.5 6h4a3 3 0 0 1 3 3v.5"></path>
      </svg>
      feat/auth-refactor
    </span>
  </div>

  <div class="term">
    {
      LINES.map((line) => (
        <div class:list={["ln", line.sp && "sp"]} style={`--at:${line.at}s`}>{line.prompt ? <span class="prompt">$ </span> : null}{line.type ? <span class="typed" style={`--dur:${line.type.dur}s;--n:${line.type.n}`}>{line.segs.map((seg) => <span class={seg.c}>{seg.t}</span>)}</span> : line.segs.map((seg) => <span class={seg.c}>{seg.t}</span>)}</div>
      ))
    }
    <div class="ln sp" style={`--at:${END}s`}><span class="prompt">$ </span><span class="dm-caret"></span></div>
  </div>
</div>

<style>
  .cli {
    /* The line length the transcript is sized against, so the body font can be
     * derived from the card's own width rather than the viewport's. */
    container-type: inline-size;
  }

  .term {
    padding: 12px 14px 14px;
    background: rgba(0, 0, 0, 0.22);
    font-family: var(--font-code);
    /* Fallback for engines without container query units. */
    font-size: 11px;
    /* 74 columns at a 0.6em advance, inside 14px of padding either side. */
    font-size: clamp(9.5px, calc((100cqi - 34px) / 44.5), 12px);
    line-height: 1.55;
    color: var(--aq-white-70);
  }

  .ln {
    /* Column alignment is the whole point of `padEnd`, so runs of spaces stay. */
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
    animation-name: cli-in;
    animation-duration: 0.14s;
    animation-delay: var(--at);
    animation-timing-function: linear;
    animation-fill-mode: both;
  }

  .sp {
    margin-top: 0.9em;
  }

  .prompt {
    color: var(--aq-white-45);
  }

  /* Typed text is revealed one column at a time; `--at` is inherited from .ln. */
  .typed {
    color: var(--text-strong);
    animation-name: cli-type;
    animation-duration: var(--dur);
    animation-delay: var(--at);
    animation-timing-function: steps(var(--n), end);
    animation-fill-mode: both;
  }

  .dim { color: var(--aq-white-45); }
  .flag { color: var(--aq-white-45); }
  .slug { color: #7dd3fc; }
  .ok { color: #86efac; }
  .run { color: #f59e0b; }
  .str { color: #c4b5fd; }

  /* Tails that only fit once the card is wide enough to print them in full.
   * Hidden, they still leave a true line — the CLI prints these suffixes last. */
  .rs,
  .aw {
    display: none;
  }

  @container (min-width: 720px) {
    .aw { display: inline; }
  }

  @container (min-width: 1000px) {
    .rs { display: inline; }
  }

  @keyframes cli-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes cli-type {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
</style>
