---
/**
 * One orchestrator, three sub-agents, three different providers, one branch.
 *
 * Resting state is every lane finished; the animation walks them back through
 * "working" on a stagger so the provider marks stay the thing you read.
 */
const LANES = [
  { name: "lane A: contracts", mark: "/harnesses/openai_dark.svg", model: "gpt-5.6-sol" },
  { name: "lane B: rpc client", mark: "/harnesses/claude-ai-icon.svg", model: "claude-fable-5" },
  { name: "lane C: adapter", mark: "/harnesses/grok-dark.svg", model: "grok-4.5" },
] as const;
---

<div class="dm orch" data-demo>
  <div class="dm-bar">
    <span class="dm-legend">Swarm</span>
    <span class="dm-branch">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="6" cy="6" r="2.5"></circle><circle cx="6" cy="18" r="2.5"></circle><circle cx="18" cy="9" r="2.5"></circle>
        <path d="M6 8.5v7"></path><path d="M8.5 6h4a3 3 0 0 1 3 3v.5"></path>
      </svg>
      feat/auth-refactor
    </span>
  </div>

  <div class="dm-body">
    <div class="dm-row dm-row--active">
      <span class="dm-dot dm-dot--plan"></span>
      <span class="dm-title">orchestrator</span>
      <code class="dm-mono dm-skill">$orchestrate</code>
    </div>

    <div class="lanes">
      {
        LANES.map((lane, index) => (
          <div class="lane" style={`--i:${index}`}>
            <span class="tick"></span>
            <span class="dm-dot dm-dot--run lane-dot"></span>
            <span class="dm-title">{lane.name}</span>
            <span class="dm-mark">
              <img src={lane.mark} alt="" width="12" height="12" loading="lazy" />
            </span>
            <span class="dm-sub lane-model">{lane.model}</span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .orch {
    /* Fixed so the trunk can stop exactly at the last lane's centre line. */
    --lane-h: 38px;
  }

  .orch .dm-bar {
    justify-content: space-between;
  }

  .lanes {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-left: 14px;
    padding-left: 16px;
  }

  /* Trunk from the orchestrator down to where the last lane branches off. */
  .lanes::before {
    content: "";
    position: absolute;
    top: -8px;
    bottom: calc(var(--lane-h) / 2);
    left: 0;
    width: 1px;
    background: var(--border-hairline);
  }

  .lane {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    height: var(--lane-h);
    padding: 0 11px;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--aq-white-04);
    overflow: hidden;
  }

  .tick {
    position: absolute;
    top: 50%;
    left: -16px;
    width: 12px;
    height: 1px;
    background: var(--border-hairline);
  }

  .lane-model {
    font-family: var(--font-code);
    font-size: 10.5px;
  }

  /* A pass of light crossing the lane that is currently working. */
  .lane::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 20%,
      rgba(255, 255, 255, 0.07) 46%,
      transparent 72%
    );
    transform: translateX(-100%);
    animation: orch-sweep 6s var(--ease-aqqua) infinite;
    animation-delay: calc(var(--i) * 0.9s);
  }

  .lane-dot {
    animation: orch-state 6s steps(1, end) infinite;
    animation-delay: calc(var(--i) * 0.9s);
  }

  @keyframes orch-sweep {
    0% { transform: translateX(-100%); }
    26% { transform: translateX(100%); }
    100% { transform: translateX(100%); }
  }

  /* Amber while the lane runs, green once it lands — resting state is green. */
  @keyframes orch-state {
    0%, 24% { background: #f59e0b; }
    25%, 100% { background: #22c55e; }
  }

  @media (max-width: 420px) {
    .lane-model { display: none; }
  }
</style>
