---
import captureManifest from "../../../public/demos/manifest.json";
import ScreenshotDemo from "./ScreenshotDemo.astro";
import VideoDemo from "./VideoDemo.astro";

interface Props {
  readonly slug: string;
  readonly class?: string;
}

interface ImageDemoAsset {
  readonly kind: "image";
  readonly src: string;
  readonly width: number;
  readonly height: number;
}

interface VideoDemoAsset {
  readonly kind: "video";
  readonly webm: string;
  readonly mp4: string;
  readonly poster: string;
  readonly width: number;
  readonly height: number;
}

type DemoAsset = ImageDemoAsset | VideoDemoAsset;

const { slug, class: className } = Astro.props;
const asset = (captureManifest as Record<string, DemoAsset>)[slug];

if (!asset) {
  throw new Error(`Missing rendered marketing demo asset for "${slug}".`);
}
---

{
  asset.kind === "video" ? (
    <VideoDemo
      webm={`/demos/${asset.webm}`}
      mp4={`/demos/${asset.mp4}`}
      poster={`/demos/${asset.poster}`}
      width={asset.width}
      height={asset.height}
      class={className}
    />
  ) : (
    <ScreenshotDemo
      src={`/demos/${asset.src}`}
      width={asset.width}
      height={asset.height}
      class={className}
    />
  )
}
