---
/**
 * The two surfaces that carry a worktree: the sidebar card registry, and the
 * conversation tab strip above the chat.
 *
 * The numbered control keeps an orchestrator's sub-agent tree behind one bounded
 * popover instead of letting it expand the strip. The popover is open at rest —
 * that is the state worth reading — and the loop only closes it briefly.
 */
const WORKTREES = [
  { branch: "feat/auth-refactor", kind: "worktree", state: "Working", dot: "run", active: true },
  { branch: "fix/pr-checks", kind: "worktree", state: "Needs input", dot: "wait", active: false },
  { branch: "main", kind: "checkout", state: "#482 merged", dot: "idle", active: false },
] as const;
---

<div class="dm wt" data-demo>
  <div class="tabs">
    <span class="tab is-active">
      auth-refactor
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </span>
    <span class="tab">
      api/routes
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </span>

    <span class="count">
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="5" r="2"></circle><circle cx="6" cy="19" r="2"></circle><circle cx="18" cy="19" r="2"></circle>
        <path d="M12 7v3M7 17l4-6M17 17l-4-6"></path>
      </svg>
      3
    </span>

    <div class="pop">
      <span class="dm-legend">Sub-agents</span>
      <span class="pop-row is-open"><span class="dm-dot dm-dot--run"></span>lane A: contracts</span>
      <span class="pop-row"><span class="dm-dot dm-dot--run"></span>lane B: rpc client</span>
      <span class="pop-row"><span class="dm-dot dm-dot--wait"></span>lane C: adapter</span>
    </div>
  </div>

  {/* The chat the strip sits above — this is what the popover overlays. */}
  <div class="chat">
    <span class="line l1"></span>
    <span class="line l2"></span>
    <span class="line l3"></span>
  </div>

  <span class="rule"></span>

  <div class="cards">
    <span class="dm-legend cards-legend">Worktrees</span>
    {
      WORKTREES.map((worktree) => (
        <div class:list={["card", worktree.active && "is-active"]}>
          <span class="grip">
            <svg width="9" height="14" viewBox="0 0 9 14" fill="currentColor">
              <circle cx="2" cy="2" r="1"></circle><circle cx="7" cy="2" r="1"></circle>
              <circle cx="2" cy="7" r="1"></circle><circle cx="7" cy="7" r="1"></circle>
              <circle cx="2" cy="12" r="1"></circle><circle cx="7" cy="12" r="1"></circle>
            </svg>
          </span>
          <span class="dm-branch card-branch">{worktree.branch}</span>
          <span class="dm-chip">{worktree.kind}</span>
          <span class="dm-spacer" />
          <span class="state">
            <span class={`dm-dot dm-dot--${worktree.dot}`} />
            {worktree.state}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .tabs {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--border-hairline);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 9px;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    font-size: 11.5px;
    line-height: 16px;
    color: var(--aq-white-55);
    white-space: nowrap;
  }

  .tab.is-active {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.07);
    color: var(--text-strong);
  }

  .tab svg {
    opacity: 0.5;
  }

  .count {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 9px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--radius-sm);
    font-size: 11.5px;
    line-height: 16px;
    font-variant-numeric: tabular-nums;
    color: var(--text-strong);
    white-space: nowrap;
    animation: wt-count 8s var(--ease-aqqua) infinite;
  }

  /* Bounded popover: the tree lives here instead of widening the strip. */
  .pop {
    position: absolute;
    top: calc(100% - 4px);
    right: 12px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 168px;
    padding: 10px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-md);
    background: #232323;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
    transform-origin: top right;
    animation: wt-pop 8s var(--ease-aqqua) infinite;
  }

  .pop-row {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    line-height: 16px;
    color: var(--aq-white-55);
    white-space: nowrap;
  }

  .pop-row.is-open {
    color: var(--text-strong);
  }

  /* Placeholder message lines, purely so the popover has something to sit over. */
  .chat {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 16px 14px 18px;
  }

  .line {
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--aq-white-08);
  }

  .l1 { width: 62%; }
  .l2 { width: 84%; }
  .l3 { width: 44%; }

  .rule {
    display: block;
    height: 1px;
    background: var(--border-hairline);
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
  }

  .cards-legend {
    padding: 2px 2px 4px;
  }

  .card {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
    padding: 10px 11px;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--aq-white-04);
  }

  .card.is-active {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.07);
  }

  .card-branch {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .grip {
    flex: none;
    display: grid;
    place-items: center;
    color: var(--aq-white-40);
  }

  .state {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    line-height: 15px;
    color: var(--aq-white-70);
    white-space: nowrap;
  }

  /* Open for most of the cycle; the close is just long enough to read as one. */
  @keyframes wt-pop {
    0%, 62% { opacity: 1; transform: scale(1) translateY(0); }
    70%, 88% { opacity: 0; transform: scale(0.94) translateY(-6px); }
    96%, 100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  @keyframes wt-count {
    0%, 62% { background: rgba(255, 255, 255, 0.07); }
    70%, 88% { background: transparent; }
    96%, 100% { background: rgba(255, 255, 255, 0.07); }
  }

  @media (max-width: 460px) {
    .tab:nth-of-type(2) { display: none; }
    .card .dm-chip { display: none; }
  }
</style>
