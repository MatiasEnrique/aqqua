---
interface Props {
  readonly id?: string;
  readonly title: string;
  readonly body: string;
  readonly points?: readonly string[];
  /** Place the demo on the left. Copy stays first in the DOM either way. */
  readonly reverse?: boolean;
}

const { id, title, body, points, reverse = false } = Astro.props;
---

<div class:list={["feature-row", reverse && "is-reversed", "reveal"]} id={id}>
  <div class="feature-copy">
    <h3>{title}</h3>
    <p set:html={body} />
    {
      points && (
        <ul class="dashlist">
          {points.map((point) => (
            <li>
              <span aria-hidden="true">—</span>
              <span set:html={point} />
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="feature-demo">
    <slot />
  </div>
</div>

<style>
  .feature-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(var(--space-8), 4vw, var(--space-16));
    align-items: center;
  }

  .feature-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 46ch;
    min-width: 0;
  }

  .feature-demo {
    min-width: 0;
  }

  /*
   * Visual-only swap: copy stays first in the DOM so reading order never
   * depends on which side the demo happens to sit on.
   */
  .feature-row.is-reversed .feature-copy {
    order: 2;
  }

  .feature-copy h3 {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.1;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .feature-copy p {
    color: var(--text-secondary);
    font-size: var(--text-16);
    line-height: var(--leading-16);
    text-wrap: pretty;
  }

  .dashlist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: var(--text-14);
    line-height: var(--leading-14);
    color: var(--text-secondary);
  }

  .dashlist li {
    display: flex;
    gap: 10px;
  }

  .dashlist li > span:first-child {
    color: var(--aq-white-40);
  }

  .dashlist :global(code) {
    font-family: var(--font-code);
    font-size: 13px;
    color: var(--text-strong);
  }

  .dashlist :global(code.code-skill) {
    color: #7dd3fc;
  }

  /* Single column: never leave the demo stranded above its own heading. */
  @media (max-width: 640px) {
    .feature-row.is-reversed .feature-copy {
      order: 0;
    }
  }
</style>
