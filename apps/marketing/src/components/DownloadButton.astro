---
import PlatformGlyph from "./PlatformGlyph.astro";

interface Props {
  readonly id: string;
  readonly labelId: string;
  readonly href: string;
  readonly variant?: "primary" | "outline";
  readonly class?: string;
}

const { id, labelId, href, variant = "primary", class: className } = Astro.props;
---

<a id={id} href={href} data-download class:list={["btn", `btn-${variant}`, "btn-lg", className]}>
  <span class="dl-icon dl-icon--apple"><PlatformGlyph platform="mac" /></span>
  <span class="dl-icon dl-icon--windows"><PlatformGlyph platform="win" /></span>
  <span class="dl-icon dl-icon--linux"><PlatformGlyph platform="linux" /></span>
  <span id={labelId} data-download-label>Download for macOS</span>
</a>

<style>
  .dl-icon {
    display: none;
    flex-shrink: 0;
    line-height: 0;
  }

  :global([data-platform="mac"]) .dl-icon--apple { display: block; }
  :global([data-platform="win"]) .dl-icon--windows { display: block; }
  :global([data-platform="linux"]) .dl-icon--linux { display: block; }
  :global(html:not([data-platform])) .dl-icon--apple { display: block; }
</style>
