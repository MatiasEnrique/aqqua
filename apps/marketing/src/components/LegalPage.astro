---
import Layout from "../layouts/Layout.astro";
import { SITE_OPERATOR } from "../lib/site";

interface Props {
  readonly title: string;
  readonly description: string;
  readonly heading: string;
  readonly lede: string;
  readonly effectiveDate: string;
  readonly lastUpdated: string;
  readonly sections: ReadonlyArray<readonly [id: string, label: string]>;
}

const { title, description, heading, lede, effectiveDate, lastUpdated, sections } = Astro.props;
---

<Layout title={title} description={description} pageClass="legal-document-page">
  <div class="legal-page">
    <a class="legal-index-link" href="/legal"><span aria-hidden="true">&#8592;</span> All legal documents</a>
    <header class="legal-hero">
      <p class="eyebrow">{SITE_OPERATOR} / Legal</p>
      <h1>{heading}</h1>
      <p class="legal-lede">{lede}</p>
      <dl class="legal-dates" aria-label="Document dates">
        <div>
          <dt>Effective Date</dt>
          <dd>{effectiveDate}</dd>
        </div>
        <div>
          <dt>Last Updated</dt>
          <dd>{lastUpdated}</dd>
        </div>
      </dl>
    </header>

    <div class="legal-rule" aria-hidden="true"></div>

    <div class="legal-layout">
      <aside class="legal-nav" aria-label="On this page">
        <p class="legal-nav-label">On this page</p>
        <ol>
          {sections.map(([id, label], index) => (
            <li>
              <a href={`#${id}`} data-legal-nav-link={id}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                {label}
              </a>
            </li>
          ))}
        </ol>
      </aside>

      <article class="legal-copy">
        <slot />
      </article>
    </div>
  </div>
</Layout>

<script>
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-legal-nav-link]"),
  );
  const sections = navLinks
    .map((link) => {
      const id = link.dataset.legalNavLink;
      const section = id ? document.getElementById(id) : null;
      return section ? { link, section } : null;
    })
    .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => entry !== null);

  let activeId = "";
  let frame = 0;

  const updateActiveSection = () => {
    frame = 0;
    const marker = Math.min(180, window.innerHeight * 0.28);
    let active = sections[0];

    for (const entry of sections) {
      if (entry.section.getBoundingClientRect().top > marker) break;
      active = entry;
    }

    if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
      active = sections[sections.length - 1];
    }

    if (!active || active.section.id === activeId) return;
    activeId = active.section.id;

    for (const { link, section } of sections) {
      if (section.id === activeId) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    }
  };

  const scheduleUpdate = () => {
    if (frame) return;
    frame = window.requestAnimationFrame(updateActiveSection);
  };

  updateActiveSection();
  window.addEventListener("scroll", scheduleUpdate, { passive: true });
  window.addEventListener("resize", scheduleUpdate);
</script>

<style is:global>
  .legal-page {
    width: min(1120px, calc(100% - 64px));
    margin: 0 auto;
    padding: clamp(72px, 10vw, 132px) 0 112px;
  }

  .legal-index-link {
    display: none;
  }

  .legal-hero {
    max-width: 820px;
    animation: fade-in 0.8s ease-out both;
  }

  .legal-hero h1 {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: var(--display-fluid);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
  }

  .legal-lede {
    max-width: var(--measure-prose);
    margin-top: var(--space-8);
    color: var(--text-secondary);
    font-size: var(--text-16);
    line-height: var(--leading-16);
  }

  .legal-dates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .legal-dates div {
    display: grid;
    gap: 4px;
  }

  .legal-dates dt,
  .legal-nav-label,
  .section-number {
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: var(--text-12);
    line-height: var(--leading-12);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .legal-dates dd {
    color: var(--text-primary);
    font-family: var(--font-code);
    font-size: var(--text-12);
    line-height: var(--leading-12);
  }

  .legal-rule {
    height: 1px;
    margin: var(--space-16) 0;
    background: linear-gradient(90deg, var(--aq-white-45), var(--border-hairline) 65%, transparent);
  }

  .legal-layout {
    display: grid;
    grid-template-columns: 210px minmax(0, 720px);
    gap: clamp(64px, 10vw, 140px);
    align-items: start;
  }

  .legal-nav {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 112px);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .legal-nav ol {
    display: grid;
    gap: 2px;
    margin-top: 16px;
    padding-bottom: 12px;
    list-style: none;
  }

  .legal-nav a {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 9px;
    margin-left: -14px;
    padding: 7px 16px 7px 14px;
    border-radius: var(--radius-control);
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.35;
    transition: var(--transition-ui);
  }

  .legal-nav a span {
    color: var(--aq-white-40);
    font-family: var(--font-code);
    font-size: 11px;
    line-height: 1.7;
  }

  .legal-nav a:hover {
    color: var(--text-primary);
    background: var(--surface-raised);
  }

  .legal-nav a[aria-current="location"] {
    color: var(--text-primary);
    background: var(--surface-hover);
  }

  .legal-nav a[aria-current="location"] span {
    color: var(--text-primary);
  }

  .legal-copy {
    min-width: 0;
  }

  .legal-copy section {
    scroll-margin-top: 104px;
  }

  .legal-copy section + section {
    margin-top: 82px;
    padding-top: 82px;
    border-top: 1px solid var(--border-hairline);
  }

  .section-number {
    color: var(--text-eyebrow);
  }

  .legal-copy h2 {
    margin: var(--space-2) 0 var(--space-6);
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: var(--text-24);
    line-height: var(--leading-24);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-display);
  }

  .legal-copy h3 {
    margin: var(--space-8) 0 10px;
    color: var(--text-primary);
    font-size: var(--text-16);
    line-height: var(--leading-16);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .legal-copy h4 {
    margin: var(--space-6) 0 var(--space-2);
    color: var(--text-primary);
    font-size: var(--text-14);
    line-height: var(--leading-14);
    font-weight: var(--weight-semibold);
  }

  .legal-copy p,
  .legal-copy li,
  .legal-copy address {
    color: var(--text-secondary);
    font-size: var(--text-16);
    font-style: normal;
    line-height: 1.75;
  }

  .legal-copy p + p {
    margin-top: 18px;
  }

  .legal-copy strong {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }

  .legal-copy ul,
  .legal-copy ol {
    display: grid;
    gap: 12px;
    margin: 18px 0 20px;
    padding-left: 1.2rem;
  }

  .legal-copy li {
    padding-left: 7px;
  }

  .legal-copy li::marker {
    color: var(--aq-white-45);
  }

  .legal-copy .provider-list {
    gap: 28px;
  }

  .provider-list a,
  .legal-copy a {
    overflow-wrap: anywhere;
  }

  .legal-copy a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--aq-white-40);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--duration-ui) var(--ease-aqqua);
  }

  .legal-copy a:hover {
    text-decoration-color: var(--text-primary);
  }

  .legal-notice {
    color: var(--text-primary) !important;
    font-weight: var(--weight-semibold);
  }

  .legal-copy address {
    margin-top: 20px;
  }

  .contact-link {
    display: inline-block;
    margin-top: 18px;
    font-family: var(--font-code);
    font-size: var(--text-14);
  }

  @media (max-width: 820px) {
    .legal-index-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 38px;
      color: var(--text-secondary);
      font-family: var(--font-ui);
      font-size: var(--text-12);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
    }

    .legal-page {
      width: min(100% - 40px, 720px);
      padding-top: 56px;
      padding-bottom: 80px;
    }

    .legal-rule {
      margin: 52px 0;
    }

    .legal-layout {
      display: block;
    }

    .legal-nav {
      display: none;
    }

    .legal-copy section + section {
      margin-top: 62px;
      padding-top: 62px;
    }
  }

  @media (max-width: 420px) {
    .legal-page {
      width: calc(100% - 32px);
      padding-top: 42px;
    }

    .legal-lede {
      margin-top: var(--space-6);
    }

    .legal-dates {
      gap: var(--space-6);
    }
  }
</style>
