{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "aqqua-marketing",
  "compatibility_date": "2026-08-03",

  "assets": {
    "directory": "dist",

    "html_handling": "auto-trailing-slash",

    "not_found_handling": "none",
  },

  "routes": [
    {
      "pattern": "aqqua.ai",
      "custom_domain": true,
    },
  ],
}
